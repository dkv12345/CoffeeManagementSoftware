    <property name="styleSheet">
     <string notr="true">#textBrowser_clock {
    background-color: rgb(172, 164, 148);  /* Màu nền nâu nhạt */
    color: #5C4033;             /* Màu chữ nâu đậm */
    font-size: 42px;            /* Kích thước chữ lớn */
    font-weight: bold;
    font-family: 'DS-Digital', sans-serif; /* Font số điện tử */
 
    border-radius: 10px;         /* Bo góc */
    padding: 15px;
    border: 2px solid #8B5A2B;  /* Viền nâu đậm */

    /* Đảm bảo kích thước không bị bó hẹp */
    min-height: 60px; 
    min-width: 200px; 
}
</string>
