    <property name="styleSheet">
     <string notr="true">QGroupBox {
    font: 20pt &quot;Franklin Gothic Medium Cond&quot;;
    color: rgb(77, 10, 24);
    border: 2px solid grey;  /* Viền màu xám */
    border-radius: 15px;  /* Bo góc 10px */
    padding: 10px;
    background-color: rgb(172, 164, 148);
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;  /* Canh tiêu đề ở giữa */
    padding: 5px;
    background-color: rgb(172, 164, 148);
    border-radius: 5px;  /* Bo góc cho phần tiêu đề */
}
</string>
