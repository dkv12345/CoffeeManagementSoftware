    <property name="styleSheet">
     <string notr="true">QPushButton {
    background-color: #8B5E3C; /* Màu nâu cà phê đậm */
    color: white;
    border-radius: 12px;
    padding: 12px;
    font-size: 14px;
    font-weight: bold;
    border: 2px solid #4E342E; /* Viền nâu trầm */
}

QPushButton:hover {
    background-color: #6D4C41; /* Màu nâu đất đậm hơn khi hover */
    border: 2px solid #3E2723; /* Viền nâu đậm hơn */
}

QPushButton:pressed {
    background-color: #A1887F; /* Màu be nâu sáng khi nhấn */
    border: 2px solid #6D4C41; /* Viền nâu trung tính */
}
</string>
